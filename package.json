{
  "name": "what-do-you-mean",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time conversation understanding tool (啥意思)",
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/electron-app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm --workspace packages/shared run build",
    "build:backend": "npm --workspace packages/backend run build",
    "build:electron": "npm --workspace packages/electron-app run build",
    "dev:backend": "npm --workspace packages/backend run dev",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/mulish": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7"
  },
  "dependencies": {
    "gsap": "^3.14.2"
  }
}
